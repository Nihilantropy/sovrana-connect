{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SovranaConnect",
  "version": "0.0.3",
  "identifier": "com.sovranaai.connect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SovranaConnect",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0A0A0A",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Nihilantropy/sovrana-connect/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_MINISIGN_PUBKEY_FROM_TAURI_SIGNER_GENERATE"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
